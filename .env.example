# Exchange API keys EXCHANGE_API_KEY=your_exchange_api_key EXCHANGE_SECRET=your_exchange_secret # Database DATABASE_URL=postgresql://user:password@localhost:5432/grinch # Telegram notifications TELEGRAM_BOT_TOKEN=your_telegram_bot_token TELEGRAM_CHAT_ID=your_telegram_chat_id # AI backend GROQ_API_KEY=your_groq_api_key # Flask SECRET_KEY=change-this-to-a-random-secret-key FLASK_ENV=production LOG_LEVEL=INFO # Trading defaults SYMBOL=TONUSDT TRADE_AMOUNT=100 MAX_OPEN_TRADES=5 TAKE_PROFIT_PCT=2.0 TRAILING_STOP_PCT=1.5 MIN_AI_CONFIDENCE=0.7 USE_DYNAMIC_TARGETS=true # VPS deployment (for GitHub Actions) VPS_HOST=your.vps.ip.address VPS_USER=root